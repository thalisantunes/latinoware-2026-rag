# Copie para .env e ajuste. O Makefile carrega o .env; fora dele: uv run --env-file .env python ...
# Valores sem aspas.
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
LLM_MODEL=qwen3:14b
LLM_MAX_TOKENS=800
# Provedor externo opcional, compatível com a API OpenAI. Sem chave, usa o Ollama local.
# Com chave, defina também LLM_BASE_URL e LLM_MODEL. Perguntas e trechos saem da máquina.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
WEAVIATE_HTTP_PORT=18080
WEAVIATE_GRPC_PORT=15051
HYBRID_ALPHA=0.75
API_HOST=0.0.0.0
API_PORT=8765
MAX_CONCORRENCIA=2
CORS_ORIGINS=https://ilove.the.br,https://www.ilove.the.br,https://rede-cidades.pages.dev,http://localhost:8765
WHISPER_MODEL=large-v3-turbo
# Só se o YouTube pedir login: cookies.txt (formato Netscape). Uso por sua conta e risco (ver README)
# YTDLP_COOKIES=/caminho/para/cookies.txt
