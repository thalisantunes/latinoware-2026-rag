# Copie para .env e ajuste. O Makefile carrega o .env; fora dele: uv run --env-file .env python ...
# Valores sem aspas.
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
# gemma4 escolhido pelo benchmark (docs/benchmark-modelos.md); qwen3:14b fica como alternativa
LLM_MODEL=gemma4:12b-it-qat
LLM_MAX_TOKENS=800
# quanto o modelo fica na GPU depois da última resposta (vazio = padrão do Ollama)
# LLM_KEEP_ALIVE=10m
# Ollama de outro host da rede local para gerar as respostas (o embedding fica no OLLAMA_URL). Sem autenticação:
# só em rede privada, nunca exposto. Se não responder, a API volta ao modo só busca. Não comite o endereço:
# deixe em arquivo fora do repo e carregue no systemd com um segundo EnvironmentFile=.
OLLAMA_GERACAO_URL=
# Provedor externo opcional, compatível com a API OpenAI. Sem chave, usa o Ollama local.
# Com chave, defina também LLM_BASE_URL e LLM_MODEL. Perguntas e trechos saem da máquina.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
WEAVIATE_HTTP_PORT=18080
WEAVIATE_GRPC_PORT=15051
HYBRID_ALPHA=0.75
API_HOST=0.0.0.0
API_PORT=8765
MAX_CONCORRENCIA=2
CORS_ORIGINS=https://ilove.the.br,https://www.ilove.the.br,https://rede-cidades.pages.dev,https://latinoware.org,https://www.latinoware.org,http://localhost:8765
WHISPER_MODEL=large-v3-turbo
# Só se o YouTube pedir login: cookies.txt (formato Netscape). Uso por sua conta e risco (ver README)
# YTDLP_COOKIES=/caminho/para/cookies.txt

# Reranker opcional (bge-reranker-v2-m3). Na GPU desta máquina: `uv sync --extra rerank` e
# RERANK_LOCAL=BAAI/bge-reranker-v2-m3 (~0,25 s para 32 trechos, ~1,4 GB de VRAM). Ou um serviço no formato
# Jina/Cohere (/v1/rerank), como llama.cpp (llama-server --reranking) ou Infinity, em RERANK_URL (em CPU,
# ~6 s por pergunta). Os dois vazios = sem reranker.
RERANK_LOCAL=
RERANK_URL=
# só para RERANK_URL: quantos candidatos mandar ao serviço
RERANK_TOP=16

# Pasta da página da RAG no repositório do site institucional, para `make publicar-site`
SITE_RAG=
